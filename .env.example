# Postgres (Neon). Pooled URL for the app, direct URL for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# LLM tagging
ANTHROPIC_API_KEY=
TAGGER_MODEL=claude-haiku-5-5

# Sources
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# Optional
LOG_LEVEL=INFO

# --- jobhunt (personal job-search toolkit, python -m jobhunt) ---
# Printed on every resume; kept out of git because the repo is public.
CANDIDATE_PHONE=
CANDIDATE_EMAIL=
# Tailoring model (uses ANTHROPIC_API_KEY above). Without a key, tailoring falls back to keywords.
TAILOR_MODEL=claude-opus-5-5
TAILOR_EFFORT=medium
# Gmail sync: an App Password (Google Account > Security > 2-Step Verification > App passwords),
# 16 letters; spaces are ignored. GMAIL_ADDRESS defaults to CANDIDATE_EMAIL.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Optional: where the tracker and tailored resumes live (default jobhunt/data, git-ignored).
JOBHUNT_DATA_DIR=
# Optional: Chrome/Chromium binary if you skip `playwright install chromium`.
CHROMIUM_PATH=
